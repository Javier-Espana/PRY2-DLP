%{
/* Parser for simple structured language (MEDIUM complexity) */
%}

%token ID NUMBER STRING SEMI COMMA
%token IF ELSE WHILE FOR INT BOOL RETURN
%token TRUE FALSE
%token ASSIGN EQ NE LT GT LE GE
%token PLUS MINUS TIMES DIV MOD
%token AND OR NOT
%token LBRACE RBRACE LPAREN RPAREN LBRACK RBRACK

%start program

%%

program
    : statement_list         { $$ = Program($1) }
    ;

statement_list
    : statement              { $$ = [$1] }
    | statement_list statement { $$ = $1 + [$2] }
    ;

statement
    : expr SEMI              { $$ = ExprStmt($1) }
    | INT ID SEMI            { $$ = DeclStmt("int", $2) }
    | INT ID ASSIGN expr SEMI { $$ = DeclAssignStmt("int", $2, $4) }
    | ID ASSIGN expr SEMI    { $$ = AssignStmt($1, $3) }
    | RETURN expr SEMI       { $$ = ReturnStmt($2) }
    | IF LPAREN expr RPAREN block { $$ = IfStmt($3, $5, None) }
    | IF LPAREN expr RPAREN block ELSE block { $$ = IfStmt($3, $5, $7) }
    | WHILE LPAREN expr RPAREN block { $$ = WhileStmt($3, $5) }
    | FOR LPAREN statement expr SEMI expr RPAREN block { $$ = ForStmt($3, $4, $6, $8) }
    | block                  { $$ = $1 }
    ;

block
    : LBRACE statement_list RBRACE { $$ = Block($2) }
    | LBRACE RBRACE          { $$ = Block([]) }
    ;

expr
    : primary                { $$ = $1 }
    | ID ASSIGN expr         { $$ = AssignExpr($1, $3) }
    | expr PLUS expr         { $$ = BinOp($1, "+", $3) }
    | expr MINUS expr        { $$ = BinOp($1, "-", $3) }
    | expr TIMES expr        { $$ = BinOp($1, "*", $3) }
    | expr DIV expr          { $$ = BinOp($1, "/", $3) }
    | expr MOD expr          { $$ = BinOp($1, "%", $3) }
    | expr EQ expr           { $$ = BinOp($1, "==", $3) }
    | expr NE expr           { $$ = BinOp($1, "!=", $3) }
    | expr LT expr           { $$ = BinOp($1, "<", $3) }
    | expr GT expr           { $$ = BinOp($1, ">", $3) }
    | expr LE expr           { $$ = BinOp($1, "<=", $3) }
    | expr GE expr           { $$ = BinOp($1, ">=", $3) }
    | expr AND expr          { $$ = BinOp($1, "&&", $3) }
    | expr OR expr           { $$ = BinOp($1, "||", $3) }
    | NOT expr               { $$ = UnOp("!", $2) }
    | ID LPAREN RPAREN       { $$ = Call($1, []) }
    | ID LPAREN expr_list RPAREN { $$ = Call($1, $3) }
    ;

expr_list
    : expr                   { $$ = [$1] }
    | expr_list COMMA expr   { $$ = $1 + [$3] }
    ;

primary
    : NUMBER                 { $$ = Number($1) }
    | STRING                 { $$ = String($1) }
    | ID                     { $$ = Var($1) }
    | TRUE                   { $$ = Bool(True) }
    | FALSE                  { $$ = Bool(False) }
    | LPAREN expr RPAREN     { $$ = $2 }
    ;

%%
