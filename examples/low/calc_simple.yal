(* Lexer for simple arithmetic expressions (LOW complexity) *)

let digit = ['0'-'9']
let letter = ['a'-'z''A'-'Z''_']
let id = letter (letter | digit)*
let ws = [' ''\t''\n''\r']+

rule tokens =
	ws          { skip() }
| digit+      { return "NUMBER" }
| id          { return "ID" }
| '+'         { return "PLUS" }
| '-'         { return "MINUS" }
| '*'         { return "TIMES" }
| '/'         { return "DIV" }
| '('         { return "LPAREN" }
| ')'         { return "RPAREN" }
