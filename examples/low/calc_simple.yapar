%{
/* Parser for simple arithmetic expressions (LOW complexity) */
%}

%token NUMBER ID
%token PLUS MINUS TIMES DIV
%token LPAREN RPAREN

%start expr

%%

expr
    : term
    | expr PLUS term          { $$ = BinOp($1, "+", $3) }
    | expr MINUS term         { $$ = BinOp($1, "-", $3) }
    ;

term
    : factor
    | term TIMES factor       { $$ = BinOp($1, "*", $3) }
    | term DIV factor         { $$ = BinOp($1, "/", $3) }
    ;

factor
    : NUMBER                  { $$ = Number($1) }
    | ID                      { $$ = Var($1) }
    | LPAREN expr RPAREN      { $$ = $2 }
    ;

%%
