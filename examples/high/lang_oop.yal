(* Lexer for OOP-like language (HIGH complexity) *)

let digit = ['0'-'9']
let hex_digit = ['0'-'9''a'-'f''A'-'F']
let letter = ['a'-'z''A'-'Z''_']
let id = letter (letter | digit)*
let number = digit+
let float = digit+ '.' digit+
let hex = "0x" hex_digit+
let string = '"' ([^'"'] | '\\"' | '\\n')* '"'
let char_lit = '\'' ([^'\''] | '\\'\'')+ '\''
let ws = [' ''\t''\n''\r']+
let comment = "//" [^'\n']*
let mlcomment = "/*" ([^*] | '*' [^/])* "*/"

rule tokens =
	ws              { skip() }
| comment         { skip() }
| mlcomment       { skip() }
| "class"        { return "CLASS" }
| "interface"    { return "INTERFACE" }
| "extends"      { return "EXTENDS" }
| "implements"   { return "IMPLEMENTS" }
| "public"       { return "PUBLIC" }
| "private"      { return "PRIVATE" }
| "protected"    { return "PROTECTED" }
| "static"       { return "STATIC" }
| "final"        { return "FINAL" }
| "abstract"     { return "ABSTRACT" }
| "void"         { return "VOID" }
| "int"          { return "INT" }
| "float"        { return "FLOAT_TYPE" }
| "double"       { return "DOUBLE" }
| "boolean"      { return "BOOLEAN" }
| "char"         { return "CHAR_TYPE" }
| "String"       { return "STRING_TYPE" }
| "new"          { return "NEW" }
| "this"         { return "THIS" }
| "super"        { return "SUPER" }
| "if"           { return "IF" }
| "else"         { return "ELSE" }
| "while"        { return "WHILE" }
| "do"           { return "DO" }
| "for"          { return "FOR" }
| "foreach"      { return "FOREACH" }
| "switch"       { return "SWITCH" }
| "case"         { return "CASE" }
| "default"      { return "DEFAULT" }
| "break"        { return "BREAK" }
| "continue"     { return "CONTINUE" }
| "return"       { return "RETURN" }
| "try"          { return "TRY" }
| "catch"        { return "CATCH" }
| "finally"      { return "FINALLY" }
| "throw"        { return "THROW" }
| "throws"       { return "THROWS" }
| "import"       { return "IMPORT" }
| "package"      { return "PACKAGE" }
| "null"         { return "NULL" }
| "true"         { return "TRUE" }
| "false"        { return "FALSE" }
| "instanceof"   { return "INSTANCEOF" }
| id              { return "ID" }
| float           { return "FLOAT" }
| hex             { return "HEX" }
| number          { return "NUMBER" }
| string          { return "STRING" }
| char_lit        { return "CHAR" }
| "+="           { return "PLUS_ASSIGN" }
| "-="           { return "MINUS_ASSIGN" }
| "*="           { return "TIMES_ASSIGN" }
| "/="           { return "DIV_ASSIGN" }
| "%="           { return "MOD_ASSIGN" }
| "&="           { return "AND_ASSIGN" }
| "|="           { return "OR_ASSIGN" }
| "^="           { return "XOR_ASSIGN" }
| "<<="          { return "LSHIFT_ASSIGN" }
| ">>="          { return "RSHIFT_ASSIGN" }
| "=="           { return "EQ" }
| "!="           { return "NE" }
| "<="           { return "LE" }
| ">="           { return "GE" }
| "<<"           { return "LSHIFT" }
| ">>"           { return "RSHIFT" }
| "++"           { return "INC" }
| "--"           { return "DEC" }
| "&&"           { return "AND" }
| "||"           { return "OR" }
| "!"            { return "NOT" }
| "&"            { return "BIT_AND" }
| "|"            { return "BIT_OR" }
| "^"            { return "XOR" }
| "~"            { return "BIT_NOT" }
| "?"            { return "QUESTION" }
| ":"            { return "COLON" }
| "."            { return "DOT" }
| ","            { return "COMMA" }
| ";"            { return "SEMI" }
| "{"            { return "LBRACE" }
| "}"            { return "RBRACE" }
| "("            { return "LPAREN" }
| ")"            { return "RPAREN" }
| "["            { return "LBRACK" }
| "]"            { return "RBRACK" }

{WS}+               { skip() }
{COMMENT}           { skip() }
{MLCOMMENT}         { skip() }

%%
