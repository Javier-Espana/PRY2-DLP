(* Lexer for simple structured language (MEDIUM complexity) *)

let digit = ['0'-'9']
let letter = ['a'-'z''A'-'Z''_']
let id = letter (letter | digit)*
let number = digit+
let string = '"' ([^'"'])* '"'
let ws = [' ''\t''\n''\r']+
let comment = "//" [^'\n']*

rule tokens =
	ws              { skip() }
| comment         { skip() }
| "if"           { return "IF" }
| "else"         { return "ELSE" }
| "while"        { return "WHILE" }
| "for"          { return "FOR" }
| "int"          { return "INT" }
| "bool"         { return "BOOL" }
| "return"       { return "RETURN" }
| "true"         { return "TRUE" }
| "false"        { return "FALSE" }
| id              { return "ID" }
| number          { return "NUMBER" }
| string          { return "STRING" }
| "="            { return "ASSIGN" }
| "=="           { return "EQ" }
| "!="           { return "NE" }
| "<"            { return "LT" }
| ">"            { return "GT" }
| "<="           { return "LE" }
| ">="           { return "GE" }
| "+"            { return "PLUS" }
| "-"            { return "MINUS" }
| "*"            { return "TIMES" }
| "/"            { return "DIV" }
| "%"            { return "MOD" }
| "&&"           { return "AND" }
| "||"           { return "OR" }
| "!"            { return "NOT" }
| "{"            { return "LBRACE" }
| "}"            { return "RBRACE" }
| "("            { return "LPAREN" }
| ")"            { return "RPAREN" }
| "["            { return "LBRACK" }
| "]"            { return "RBRACK" }
| ";"            { return "SEMI" }
| ","            { return "COMMA" }
