%{
/* Lexer for simple arithmetic expressions (LOW complexity) */
%}

DIGIT = [0-9]
ID = [a-zA-Z_][a-zA-Z0-9_]*
WS = [ \t\n\r]

%%

{DIGIT}+           { return("NUMBER", lexeme) }
{ID}                { return("ID", lexeme) }
"+"                 { return("PLUS", lexeme) }
"-"                 { return("MINUS", lexeme) }
"*"                 { return("TIMES", lexeme) }
"/"                 { return("DIV", lexeme) }
"("                 { return("LPAREN", lexeme) }
")"                 { return("RPAREN", lexeme) }
{WS}+               { skip() }

%%
